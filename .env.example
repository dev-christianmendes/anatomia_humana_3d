# Anatomia 3D - ambiente de desenvolvimento.
# O viewer V2 carrega o atlas localmente (public/models/fullbody) e nao consome VITE_API_URL.
# A API continua disponivel para integracao: mantenha CORS_ALLOWED_ORIGINS alinhado ao
# endereco do frontend. Nunca incluir segredos com prefixo VITE_,
# pois esses valores sao incorporados ao JavaScript entregue ao navegador.
DATABASE_URL=jdbc:postgresql://localhost:5432/anatomia
DATABASE_USERNAME=anatomia
DATABASE_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173