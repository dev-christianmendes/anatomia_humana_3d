# Anatomia 3D - ambiente de desenvolvimento.
# VITE_API_URL eh consumida pelo frontend: define-a para buscar dados na API.
# As demais variaveis sao usadas pelo backend/Compose. Nunca incluir segredos com prefixo VITE_,
# pois esses valores sao incorporados ao JavaScript entregue ao navegador.
DATABASE_URL=jdbc:postgresql://localhost:5432/anatomia
DATABASE_USERNAME=anatomia
DATABASE_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8080