# Anatomia 3D - ambiente de desenvolvimento.
# O viewer V2 carrega o atlas localmente (public/models/fullbody). O catalogo v2
# (estruturas e conceitos) e consultado na API do backend (GET /api/v1/catalog/v2/snapshot)
# quando VITE_API_URL aponta para ele ou quando o /api do proprio host responde.
# Sem API disponivel, o frontend usa o fallback estatico em public/catalog/v2/.
# Para apontar o frontend para uma API em outra origem, defina VITE_API_URL
# (ex.: http://localhost:8080). Nunca incluir segredos com prefixo VITE_,
# pois esses valores sao incorporados ao JavaScript entregue ao navegador.
DATABASE_URL=jdbc:postgresql://localhost:5432/anatomia
DATABASE_USERNAME=anatomia
DATABASE_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# VITE_API_URL=http://localhost:8080